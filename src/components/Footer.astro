---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div><strong>{site.name}</strong><p>{site.tagline}</p></div>
  <div class="footer-links">
    <a href={site.github}>GitHub</a><a href={site.scholar}>Google Scholar</a><a href={site.linkedin}>LinkedIn</a>
  </div>
  <p class="copyright">© {new Date().getFullYear()} {site.name}. Built with Astro.</p>
</footer>
