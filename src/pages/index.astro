---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';

import { site } from '../data/site';
import { projects } from '../data/projects';
import { publications } from '../data/publications';
import { service } from '../data/service';
---

<BaseLayout>
  <!-- Intro / Hero -->
  <section class="academic-hero shell">
    <div class="hero-copy">
      <p class="kicker">
        Formal Methods · Static Analysis . Programming Languages · Systems Security
      </p>

      <p class="lead">
        My research interests span formal methods, static analysis, programming languages, software security, 
        and the application of formal methods across diverse areas of computer science. 
        I develop machine-checked proofs using the  <a
        href="https://rocq-prover.org/"
        target="_blank"
        rel="noopener noreferrer"
        >
        Rocq
        </a>(formerly Coq) proof assistant to establish strong 
        correctness and security guarantees, with the broader goal of building trustworthy computing systems. 
        Much of my research is carried out using Rocq.
      </p>

      <div class="inline-links">
        <a href="/research/">Research</a>
        <a href="/publications/">Publications</a>        
      </div>
    </div>

    <figure class="portrait">
      <img src="/mypic.jpg" alt="Portrait of Swarn Priya" />
    </figure>
  </section>

  <!-- About and Contact -->
  <section class="section shell">
    <div class="overview-layout">
      <div class="main-column">
        <p class="kicker">Overview</p>

        <h2>About me</h2>

        <p>
          I am a Research Assistant Professor 
          in the <a
        href="https://school.eecs.wsu.edu/"
        target="_blank"
        rel="noopener noreferrer"
        >School of Electrical Engineering and Computer Science</a> at <a
        href="https://wsu.edu/"
        target="_blank"
        rel="noopener noreferrer"
        >Washington State University</a>. 
        </p>
        <p>
          Before joining WSU, I was a Postdoctoral Research Associate in the <a
        href="https://www.ssrg.ece.vt.edu/"
        target="_blank"
        rel="noopener noreferrer"
        >Systems Software Research Group</a> 
          within the Bradley Department of Electrical and Computer Engineering at Virginia Tech.
          During this time, I led the development of BeePL, a formally verified programming language and compiler for eBPF 
          that aims to provide machine-checked guarantees of safety, correctness, and security for systems software.
          I received my Ph.D. from <a
        href="https://www.inria.fr/en/inria-centre-universite-cote-azur"
        target="_blank"
        rel="noopener noreferrer"
        >Inria, Sophia Antipolis</a> and <a
        href="https://univ-cotedazur.fr/"
        target="_blank"
        rel="noopener noreferrer"
        >Université Côte d'Azur, France</a>, 
          where I worked with <a
        href="https://www-sop.inria.fr/members/Yves.Bertot/research.html"
        target="_blank"
        rel="noopener noreferrer"
        > Yves Bertot</a> and <a
        href="https://www-sop.inria.fr/members/Benjamin.Gregoire/"
        target="_blank"
        rel="noopener noreferrer"
        > Benjamin Grégoire</a> as a member of the <a
        href="https://team.inria.fr/stamp/"
        target="_blank"
        rel="noopener noreferrer"
        >STAMP</a> and <a
        href="https://team.inria.fr/splits/"
        target="_blank"
        rel="noopener noreferrer"
        >SPLiTS</a> research teams. 
          My Ph.D. research focused on applying formal methods to computer security, 
          with an emphasis on designing a formally verified secure compiler that provides 
          machine-checked guarantees against timing-based side-channel attacks.
        </p>

        <a class="arrow-link" href="/research/">
          Read more about my research →
        </a>
      </div>

      <aside class="contact-card">
        <h3>Contact</h3>

        <p>
          {site.department}<br />
          Washington State University<br />
          Pullman, Washington
        </p>

        <p>
         <strong>Email</strong><br />{site.email}
        </p>

        <p class="small-links">
          <a href={site.scholar}>Google Scholar</a>
          ·
          <a href={site.github}>GitHub</a>
          ·
          <a href={site.linkedin}>LinkedIn</a>
        </p>

        <p class="muted">
          Open to research collaborations and conversations with students
          interested in formal methods and secure systems.
        </p>
      </aside>
    </div>
  </section>

  <!-- Research -->
