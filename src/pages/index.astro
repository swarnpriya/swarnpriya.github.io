<section class="section shell">
  <div class="section-top">
    <div>
      <p class="kicker">Research</p>
      <h2>Current Research Directions</h2>
    </div>
  </div>
  
  <p class="section-intro">
    <strong>Research Vision.</strong> PAWSSEC (Provable Assurance for Whole-System
    Security) is a long-term research vision for achieving end-to-end,
    machine-checked security guarantees across the computing stack, from
    programming languages and compilers to systems and hardware.
  </p>

  <div class="thrust-grid">
    {projects.slice(0, 4).map((project, index) => (
      <article class="thrust">
        <span>
          Research Direction {String(index + 1).padStart(2, "0")}
        </span>

        <h3>{project.title}</h3>

        <p>{project.summary}</p>
      </article>
    ))}
  </div>
</section>
-->

  <!-- Publications and News -->
  <section class="section shell two-column-section">
    <div>
      <div class="section-top">
        <div>
          <p class="kicker">Selected work</p>
          <h2>Publications</h2>
        </div>

        <a class="arrow-link" href="/publications/">
          All publications →
        </a>
      </div>

      <div class="publication-list compact">
        {
          publications
            .slice(0, 4)
            .map((publication) => (
              <PublicationCard publication={publication} />
            ))
        }
      </div>
    </div>

   <aside class="news-preview">
  <p class="kicker">Recent news</p>
  <h2>Updates</h2>
    <div class="simple-list">
  <a href="/news/">
    <time>2025</time>
    <span>
      Invited to present my research at the France Science Summit 2025, held in Washington, DC.
    </span>
  </a>

  <a href="/news/">
  <time>2025</time>
  <span>
    Attended NSF FMitF PI Meeting in Iowa and presented my research directions.
  </span>
</a>

  <a href="/news/">
  <time>2025, 2024</time>
  <span>
    Presented <em>BeePL: Correct-by-Compilation Kernel Extensions</em> at the DARPA PI Meeting.
  </span>
</a>

  <a href="/news/">
    <time>2023</time>
    <span>
      Invited to serve on the Formal Methods for Security panel at Google, Paris.
    </span>
  </a>

  <a href="/news/">
    <time>2023</time>
    <span>
      Received the UNESCO–L'Oréal Young Talent Women in Science Award.
    </span>
  </a>

  <a href="/news/">
    <time>2023</time>
    <span>
      Received the IEEE S&amp;P Distinguished Paper Award.
    </span>
  </a>
  </div>
</aside>
</section>
</BaseLayout>